# Grok Build WebUI — compose environment
# Copy to .env (scripts/install.sh does this for you) and adjust.

# ---- identity of the host user the container runs as -----------------------
UID=1000
GID=1000
HOME_DIR=/home/karutoil

# ---- webui settings --------------------------------------------------------
WEBUI_PORT=8080                 # what the server listens on (host-network mode)
PUBLIC_URL=                     # e.g. https://grok.example.com (Cloudflare tunnel)
DATA_DIR_HOST=./data            # where sqlite db lives on the HOST
DATA_DIR=/app/data              # same dir as seen inside the container

# ---- grok CLI --------------------------------------------------------------
GROK_BIN=grok                   # leave "grok": PATH includes $HOME_DIR/.local/bin
MAX_SESSIONS=16

# ---- binary supply (native mode) -------------------------------------------
# GitHub "owner/name" whose Releases carry the prebuilt static binaries made
# by .github/workflows/release.yml (automatic on every push to main).
# scripts/install.sh saves this when you pass --repo; leaving it unset lets
# the git remote win.
#REPO=karutoil/grok-build-webui

# ---- docker image -----------------------------------------------------------
# Docker mode pulls a prebuilt CI image by default; set WEBUI_IMAGE to pin a
# version or use your own registry. Local build stays as offline fallback.
#WEBUI_IMAGE=ghcr.io/karutoil/grok-build-webui:latest

TZ=UTC
